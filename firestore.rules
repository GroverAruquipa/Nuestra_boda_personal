rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the two of you can read or write the wedding data.
    // Replace the two emails with your Google accounts.
    match /weddings/{doc} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['your.email@gmail.com', 'her.email@gmail.com'];
    }
  }
}
